+def _run_ui_helpers(script):
+    node_binary = shutil.which("node")
+    if node_binary is None:
+        candidates = sorted(Path("/opt/nvm/versions/node").glob("*/bin/node"))
+        node_binary = str(candidates[-1]) if candidates else None
+    if node_binary is None:
