+def geometry():
+    rotation = np.array([[0., 0., 1.], [1., 0., 0.], [0., 1., 0.]])
+    model = SimpleNamespace(camera_name2id=lambda name: 0 if name == "agentview" else 1,
+                            cam_fovy=[45., 45.])
+    data = SimpleNamespace(cam_xpos=np.array([[1., 0., 2.], [.1, 0., 1.2]]),
